# Leave DATABASE_URL empty to use the embedded PGlite database in ./.pglite
DATABASE_URL=postgres://user:password@localhost:5432/goti_rooms
# PGSSL=true

# Long random string, e.g. `openssl rand -base64 32`
AUTH_SECRET=change-me-to-a-long-random-string

# First admin (created on start if this email isn't in the admins table yet)
ADMIN_EMAIL=admin@example.com
# Wrap in quotes if it contains # (otherwise everything after # is ignored)
ADMIN_PASSWORD="change-me-123"
ADMIN_NAME=Vikram

# ---- Login codes by email via Resend (leave RESEND_API_KEY empty for demo mode: code shown on screen) ----
# Create an API key at resend.com and verify your sending domain there.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# EMAIL_FROM=Goti Rooms <noreply@yourdomain.com>

# ---- Wallet: Razorpay UPI QR (leave empty for demo mode with a "Simulate payment" button) ----
# Keys: Razorpay Dashboard > Account & Settings > API keys
# Webhook: Dashboard > Webhooks > URL https://<your-domain>/api/webhooks/razorpay,
#   events qr_code.credited, qr_code.closed, payment.failed, and the same secret as below.
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxx
# In production without keys, payments are off. PAYMENTS_DEMO=true forces demo mode (testing only).
# Only accept these sign-up domains (comma-separated). Empty = any email.
# ALLOWED_EMAIL_DOMAINS=gmail.com
SEED_DEMO=true
APP_TIMEZONE=Asia/Kolkata
