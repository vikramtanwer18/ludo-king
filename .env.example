# Copy to .env and fill in. Values marked REQUIRED must be set in production or the server won't start.

# ---------- Database: AWS RDS for PostgreSQL ----------
# REQUIRED. RDS console > Databases > your DB > Connectivity & security: Endpoint and Port.
# URL-encode special characters in the password (@ = %40, # = %23, / = %2F, : = %3A, ? = %3F, % = %25).
DATABASE_URL=postgres://USERNAME:PASSWORD@ENDPOINT.rds.amazonaws.com:5432/DBNAME
# SSL is automatic for *.rds.amazonaws.com and verified with certs/rds-global-bundle.pem. Other hosts:
# PGSSL=true                        # encrypt the connection
# PGSSL_CA_FILE=/path/to/ca.pem     # CA to verify the server (default: the system's CAs)
# PGSSL_REJECT_UNAUTHORIZED=false   # encrypt without verifying (not recommended)
# PG_POOL_MAX=10                    # connections per app instance; instances x this < RDS max_connections

# Local development only: `docker compose --profile local-db up -d db`, then
#   DATABASE_URL=postgres://goti:<POSTGRES_PASSWORD>@localhost:5433/goti_rooms
POSTGRES_PASSWORD=

# ---------- Security ----------
# REQUIRED. 32+ random characters, e.g. `openssl rand -base64 48`.
AUTH_SECRET=
# INSECURE_COOKIES=true             # only if you serve over plain http on something other than localhost

# ---------- First admin (created by `npm run db:migrate` if this email isn't an admin yet) ----------
ADMIN_EMAIL=
# 8+ characters. Wrap in quotes if it contains # (otherwise everything after # is ignored).
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ---------- Login codes by email (Resend: https://resend.com) ----------
# REQUIRED in production. Without it in development, the code is shown on screen.
RESEND_API_KEY=
# REQUIRED in production. Its domain must be verified in Resend.
EMAIL_FROM=Goti Rooms <noreply@yourdomain.com>
# ALLOWED_EMAIL_DOMAINS=gmail.com   # only accept these sign-up domains

APP_TIMEZONE=Asia/Kolkata

# ---------- Wallet: Razorpay UPI QR ----------
# Keys: Razorpay Dashboard > Account & Settings > API keys. Without them adding cash is off
# (development shows a "Simulate payment" button instead).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# REQUIRED when the keys are set. Webhook: Dashboard > Webhooks > URL https://<your-domain>/api/webhooks/razorpay,
#   events qr_code.credited, qr_code.closed, payment.failed, and this same secret.
RAZORPAY_WEBHOOK_SECRET=
# PAYMENTS_DEMO=true                # testing only: fake payments even in production

# ---------- Optional ----------
# RATE_LIMITS=off                   # rate limits are on in production; turn off only for load tests
# APP_PORT=3000                     # host port for docker compose
# DB_PORT=5433                      # host port of the compose database (localhost only)
