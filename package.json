{
  "name": "ludo-rooms",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/migrate.mjs && next dev",
    "build": "next build",
    "postbuild": "node scripts/postbuild.mjs",
    "start": "node --env-file-if-exists=.env scripts/migrate.mjs && node --env-file-if-exists=.env .next/standalone/server.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env scripts/seed-demo.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:api": "node --test tests/api.test.mjs",
    "test:e2e": "python tests/e2e.py"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.9"
  }
}
