# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
inbox.json
/test-results/
/playwright-report/
__pycache__/
*.pyc

# next.js
/.next/
/out/

# production
/build

# local database (embedded PGlite) - contains player data
/.pglite/

# env files: secrets (API keys, passwords). Only the example is committed.
.env
.env.*
!.env.example

# misc
.DS_Store
Thumbs.db
*.pem
*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# editors
.vscode/*
!.vscode/extensions.json
.idea/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
